# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
dist-ssr/
build/
.vite/

# Environment files — NEVER commit real credentials.
# Only .env.example (placeholder values) belongs in the repository.
.env
.env.*
!.env.example

# Secrets: Supabase service-role key, Clerk secret key, Resend API key,
# VAPID private key, webhook signing secrets. These live in the hosting
# provider's secret store, never on disk in this repository.
*.pem
*.key
secrets.json
vapid.json
.secrets/

# Supabase local state
supabase/.branches/
supabase/.temp/
supabase/.env

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs and caches
*.log
npm-debug.log*
yarn-error.log*
.eslintcache
*.tsbuildinfo

# Local tooling
coverage/
.wrangler/
artifacts/

# Python bytecode from vendored skill scripts
__pycache__/
*.pyc
