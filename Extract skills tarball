name: Extract skills tarball

on:
  workflow_dispatch:

jobs:
  extract:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4

      - name: Extract archive
        run: |
          set -euo pipefail
          test -f claude-skills-security-audit.tar.gz
          sha256sum claude-skills-security-audit.tar.gz
          tar xzf claude-skills-security-audit.tar.gz
          rm claude-skills-security-audit.tar.gz
          ls -la .claude/skills security-audit playwright-cli

      - name: Commit result
        run: |
          set -euo pipefail
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "chore: extract .claude/skills, security-audit and playwright-cli from tarball"
          git push
